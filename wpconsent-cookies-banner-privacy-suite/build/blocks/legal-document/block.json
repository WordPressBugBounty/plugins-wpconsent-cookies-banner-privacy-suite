{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpconsent/legal-document",
  "version": "1.0.0",
  "title": "WPConsent Legal Document",
  "category": "widgets",
  "icon": "media-document",
  "description": "Shows a privacy policy, cookie policy or California opt-out page generated by WPConsent.",
  "keywords": [
    "privacy",
    "policy",
    "cookie",
    "legal",
    "wpconsent"
  ],
  "textdomain": "wpconsent-cookies-banner-privacy-suite",
  "attributes": {
    "document": {
      "type": "string",
      "default": "privacy_policy"
    },
    "locale": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false
  },
  "editorScript": "file:./index.js"
}